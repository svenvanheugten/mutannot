<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <!-- Define a WINDOWS/LINUX symbol matching the build host so mutations can be
       gated with `#if WINDOWS` / `#if LINUX`. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestSupport.fs" />
    <Compile Include="VSTestRunnerTests.fs" />
    <Compile Include="CSharpTests.fs" />
    <Compile Include="ControlRunTests.fs" />
    <Compile Include="MicrosoftTestingPlatformTests.fs" />
    <Compile Include="PathSeparatorTests.fs" />
    <Compile Include="RebuildTests.fs" />
    <Compile Include="InternalsVisibleToTests.fs" />
    <Compile Include="GitTests.fs" />
    <Compile Include="JjTests.fs" />
    <Compile Include="ValidateTests.fs" />
    <Compile Include="OutsideVcsTests.fs" />
    <Compile Include="ModuleLevelTestTests.fs" />
    <Compile Include="JobsTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Mutannot/Mutannot.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Anchor the xunit v2 package closure into the restore so it lands in
       deps.json. TestSupport builds scratch xunit v2 test projects at runtime
       (see `xunitV2Packages`), which must restore these offline in the Nix
       sandbox. ExcludeAssets="all" keeps them out of this project's own
       (xunit v3) build while still pulling the full transitive graph. -->
  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.3" ExcludeAssets="all" />
  </ItemGroup>
</Project>
