<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Define a WINDOWS/LINUX symbol matching the build host so mutations can be
       gated with `#if WINDOWS` / `#if LINUX`. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="TestSupport.fs" />
    <Compile Include="FSharpTests.fs" />
    <Compile Include="CSharpTests.fs" />
    <Compile Include="ControlRunTests.fs" />
    <Compile Include="MicrosoftTestingPlatformTests.fs" />
    <Compile Include="PathSeparatorTests.fs" />
    <Compile Include="RebuildTests.fs" />
    <Compile Include="InternalsVisibleToTests.fs" />
    <Compile Include="GitTests.fs" />
    <Compile Include="ValidateTests.fs" />
    <Compile Include="ModuleLevelTestTests.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Mutannot/Mutannot.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Anchor the xunit v3 + Microsoft.Testing.Platform package closure into the
       restore so it lands in deps.json. MicrosoftTestingPlatformTests builds a
       scratch MTP project at runtime, which must restore these offline in the
       Nix sandbox. ExcludeAssets="all" keeps them out of this project's own
       (xunit v2) build while still pulling the full transitive graph. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.1.0" ExcludeAssets="all" />
  </ItemGroup>
</Project>
